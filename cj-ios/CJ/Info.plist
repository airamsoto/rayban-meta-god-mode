<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>es</string>
	<key>CFBundleDisplayName</key>
	<string>CJ</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>CJ habla con el cerebro que corre en tu Mac, dentro de tu red Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<!-- Announced by cj-mac/cj/beacon.py, so CJ finds the Mac again after its address changes. -->
		<string>_cjbrain._tcp</string>
		<!-- Meta's toolkit: the Wi-Fi link to the glasses. -->
		<string>_bonjour._tcp</string>
	</array>
	<!-- Meta Wearables Device Access Toolkit. MetaAppID "0" = Developer Mode in the Meta AI app (no attestation). -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>cjglasses://</string>
		<key>MetaAppID</key>
		<string>0</string>
		<key>ClientToken</key>
		<string>0</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cjglasses</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<!-- A conversation keeps going with the screen locked (the mic and CJ's voice stay on). -->
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Para conectar con tus gafas Ray-Ban Meta.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Para conectar con tus gafas Ray-Ban Meta.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Para decirte qué tienes hoy, unirte a reuniones de Teams y apuntar citas por voz.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Para decirte qué tienes hoy, unirte a reuniones de Teams y apuntar citas por voz.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Para tus recordatorios y la lista de la compra.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Para tus recordatorios y la lista de la compra.</string>
	<key>NSContactsUsageDescription</key>
	<string>Para llamar o escribir por WhatsApp y Teams a tus contactos por su nombre.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>msteams</string>
		<string>shortcuts</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Para oír tus preguntas a través del micrófono de las gafas o del iPhone.</string>
	<key>NSCameraUsageDescription</key>
	<string>Para escanear el código QR de emparejamiento que muestra el cerebro en tu Mac.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The brain serves plain HTTP on the home network (cj-mac/run.sh). Only local addresses are exempt. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
